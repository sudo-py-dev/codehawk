            "severity": "critical",
            "confidence": "high",
            "security-severity": "9.5"
          }
        },
        {
          "ruleId": "codehawk/injection/CWE-89",
          "level": "error",
          "message": {
            "text": "SQL injection in product search: The `q` query parameter is pasted straight into the SQL string, so the database runs whatever the visitor types. The route is public."
