        {
          "ruleId": "codehawk/bug",
          "level": "warning",
          "message": {
            "text": "Order totals are recalculated without being awaited: `orders.forEach(async …)` doesn't wait for the callbacks, so `recalcTotals` resolves before any total is written, and a failed UPDATE becomes an unhandled rejection. It also runs two queries per order (N+1)."
          },
          "locations": [
            {
              "physicalLocation": {
