            "severity": "critical",
            "confidence": "high",
            "security-severity": "9.5"
          }
        },
        {
          "ruleId": "patchhound/auth/CWE-347",
          "level": "error",
          "message": {
            "text": "Auth middleware never verifies tokens: `requireAuth` uses `jwt.decode()`, which only reads the token without checking its signature, and calls `next()` even when decoding fails. Every route behind it is effectively public."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/lib/auth.js"
                },
                "region": {
                  "startLine": 6,
                  "endLine": 11
