      "results": [
        {
          "ruleId": "patchhound/supply-chain/CWE-94",
          "level": "error",
          "message": {
            "text": "GitHub Actions runs fork code with secrets: The workflow uses `pull_request_target` (runs with repository secrets and a write token) and checks out the PR's own code. It also interpolates the PR title directly into a shell `run:` step."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/greet.yml"
                },
                "region": {
                  "startLine": 3,
                  "endLine": 12
                }
              }
            }
          ],
          "partialFingerprints": {
            "patchhoundId": ".github/workflows/greet.yml:supply-chain:GitHub Actions runs fork code with secrets"
          },
          "properties": {
            "severity": "critical",
            "confidence": "high",
            "security-severity": "9.5"
          }
        },
        {
          "ruleId": "patchhound/deserialization/CWE-502",
          "level": "error",
          "message": {
            "text": "Remote code execution via pickle import: `/import` unpickles the raw request body. Unpickling runs code embedded in the data."
          },
          "locations": [
